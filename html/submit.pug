extends layout.pug 

block title 
        <title>Soumettre un ticket</title>
block content
    <div id="body" class="body">
    <form method="post">
    <div>
        <input autocomplete="off" autofocus name="username" placeholder="Username" type="text" required>
    </div>
        <div>
            <input name="password" placeholder="Password" type="password" required>
        </div>
        <div>
            <input name="confirmation" placeholder="Password (again)" type="password" required>
        </div>
        <button type="submit">Submit</button>
    </form>
    </div>